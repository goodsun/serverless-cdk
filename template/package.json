{
  "name": "my-serverless-app",
  "version": "0.1.0",
  "description": "A serverless application built with AWS CDK",
  "bin": {
    "serverless": "bin/serverless.js"
  },
  "scripts": {
    "build": "tsc",
    "build:api": "node scripts/build-api.js",
    "build:frontend": "node scripts/build-frontend.js",
    "build:all": "npm run build && npm run build:api && npm run build:frontend",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "./scripts/set-env.sh npm run cdk deploy",
    "deploy:dev": "CDK_ENV=dev ./scripts/set-env.sh npm run cdk deploy",
    "deploy:stg": "CDK_ENV=stg ./scripts/set-env.sh npm run cdk deploy",
    "deploy:prod": "CDK_ENV=prod ./scripts/set-env.sh npm run cdk deploy",
    "destroy": "./scripts/set-env.sh npm run cdk destroy",
    "destroy:dev": "CDK_ENV=dev ./scripts/set-env.sh npm run cdk destroy",
    "destroy:stg": "CDK_ENV=stg ./scripts/set-env.sh npm run cdk destroy",
    "destroy:prod": "CDK_ENV=prod ./scripts/set-env.sh npm run cdk destroy",
    "list": "./scripts/set-env.sh npm run cdk list",
    "list:all": "echo '=== DEV ===' && CDK_ENV=dev npm run list && echo '\n=== STG ===' && CDK_ENV=stg npm run list && echo '\n=== PROD ===' && CDK_ENV=prod npm run list",
    "synth": "./scripts/set-env.sh npm run cdk synth",
    "bootstrap": "./scripts/set-env.sh npm run cdk bootstrap",
    "bootstrap:dev": "CDK_ENV=dev ./scripts/set-env.sh npm run cdk bootstrap",
    "bootstrap:stg": "CDK_ENV=stg ./scripts/set-env.sh npm run cdk bootstrap",
    "bootstrap:prod": "CDK_ENV=prod ./scripts/set-env.sh npm run cdk bootstrap",
    "prebuild": "mkdir -p dist build/frontend"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.200.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "@codegenie/serverless-express": "^4.17.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "uuid": "^10.0.0"
  }
}