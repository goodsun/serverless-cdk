# ========================================
# serverless-cdk Environment Variables
# ========================================
# 
# このファイルをコピーして .env を作成してください:
# cp .env.example .env
#
# 重要: AWS認証情報（AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY）は
# セキュリティ上の理由から、このファイルには記載しないでください。
# GitHub ActionsではSecretsを使用し、ローカルではAWS CLIの設定を使用してください。
#
# 環境別の変数:
# - _DEV: 開発環境
# - _STG: ステージング環境  
# - _PROD: 本番環境

# ========================================
# AWS Configuration
# ========================================
# CDK_ACCOUNTとCDK_REGIONは、scripts/set-env.shによって
# 環境に応じて自動的に設定されます

CDK_ACCOUNT_DEV=123456789012
CDK_ACCOUNT_STG=123456789012
CDK_ACCOUNT_PROD=234567890123

CDK_REGION_DEV=ap-northeast-1
CDK_REGION_STG=ap-northeast-1
CDK_REGION_PROD=ap-northeast-1

# ========================================
# Application Configuration
# ========================================
APP_NAME=my-serverless-app

# Log Level (環境別)
LOG_LEVEL_DEV=debug
LOG_LEVEL_STG=info
LOG_LEVEL_PROD=warn

# ========================================
# Domain Configuration (Optional)
# ========================================
# カスタムドメインを使用する場合は設定してください

# DOMAIN_NAME=example.com
# API_SUBDOMAIN_DEV=api-dev
# API_SUBDOMAIN_STG=api-stg
# API_SUBDOMAIN_PROD=api

# 共有ACM証明書を使用する場合
# USE_SHARED_CERTIFICATE=true

# または個別の証明書ARNを指定
# API_CERTIFICATE_ARN_DEV=arn:aws:acm:ap-northeast-1:123456789012:certificate/xxx
# API_CERTIFICATE_ARN_STG=arn:aws:acm:ap-northeast-1:123456789012:certificate/xxx
# API_CERTIFICATE_ARN_PROD=arn:aws:acm:ap-northeast-1:234567890123:certificate/xxx

# ========================================
# Feature Flags
# ========================================
# DynamoDB Point-in-Time Recovery
ENABLE_PITR_DEV=false
ENABLE_PITR_STG=false
ENABLE_PITR_PROD=true

# API Gateway Caching
ENABLE_API_CACHE_DEV=false
ENABLE_API_CACHE_STG=true
ENABLE_API_CACHE_PROD=true

# ========================================
# Security Configuration (Optional)
# ========================================
# 暗号化キー（本番環境では必ず変更してください）
# ENCRYPTION_KEY_DEV=dev-encryption-key-change-me
# ENCRYPTION_KEY_STG=stg-encryption-key-change-me
# ENCRYPTION_KEY_PROD=prod-encryption-key-change-me

# ========================================
# External Services (Optional)
# ========================================
# 必要に応じて外部サービスの設定を追加

# Slack Webhook URL (エラー通知用)
# SLACK_WEBHOOK_URL_DEV=https://hooks.slack.com/services/xxx
# SLACK_WEBHOOK_URL_STG=https://hooks.slack.com/services/xxx
# SLACK_WEBHOOK_URL_PROD=https://hooks.slack.com/services/xxx